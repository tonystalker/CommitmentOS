# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://commitmentos:commitmentos@localhost:5432/commitmentos

# ─── LLM (Swappable: groq, openrouter, openai, anthropic) ───
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback / alternate providers:
# LLM_PROVIDER=openrouter
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=nex-agi/nex-n2.5-mini:free

# ─── Supermemory ─────────────────────────────────────────────
SUPERMEMORY_API_KEY=sm_...

# ─── Slack (bot token from your workspace app) ────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# ─── Linear (personal API key) ───────────────────────────────
LINEAR_API_KEY=lin_api_...

# ─── Gmail (refresh token from scripts/gmail_auth.py) ────────
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...
GMAIL_REFRESH_TOKEN=...

# ─── App ─────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
